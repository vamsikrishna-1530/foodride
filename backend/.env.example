PORT=5000
MONGO_URI=mongodb://localhost:27017/foodride
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Razorpay test mode keys - get from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret

# Platform fee configuration (kept low to stay owner/delivery-partner friendly)
RESTAURANT_COMMISSION_PERCENT=8
DELIVERY_PLATFORM_FEE=10
CUSTOMER_PLATFORM_FEE=3
